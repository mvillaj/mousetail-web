# Impeccable design skill: a local install (~32 MB with its binaries), not part of
# the app. Only its outputs are tracked: PRODUCT.md, DESIGN.md and
# .impeccable/design.json.
.claude/skills/impeccable/
.claude/agents/impeccable-*.md
.github/skills/impeccable/
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json
.impeccable/config.local.json
# Its working files: review screenshots, decision-page logs, caches, build state.
# Surface briefs (*/.impeccable/surfaces/) stay tracked: they are the per-page
# design contract later sessions reload.
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/
**/.impeccable/build/
**/.impeccable/mocks/
**/.impeccable/hook.cache.json
# Per-user Claude Code settings.
.claude/settings.local.json
# Playwright: saved sign-in session (a live Clerk session token) and run output.
e2e/.auth/
e2e/.no-anthropic/
test-results/
playwright-report/

# TypeScript incremental build state.
*.tsbuildinfo

# Local Claude Code tooling (Impeccable skill, dev-server launch configs)
.claude/
